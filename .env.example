# ---------------------------------------------------------------------------
# Checkout Demo — server configuration
# Copy to .env and fill in. NEVER commit the filled-in .env.
# ---------------------------------------------------------------------------

# Port the Express server listens on (hosts usually set this for you)
PORT=3001

# Set to "production" when hosting. This also locks the merchant console so
# visitors cannot overwrite server credentials.
NODE_ENV=development

# --- Voila (app.heyvoila.io) ------------------------------------------------
# These two headers are the ONLY authentication Voila requires.
VOILA_API_USER=
VOILA_API_TOKEN=
# Company the presets are registered against, e.g. "Moov Master"
VOILA_AUTH_COMPANY=

# --- Billing API ------------------------------------------------------------
BILLING_CLIENT_NAME=Moov Parcel
BILLING_CUSTOMER_DC_ID=Kitloop
BILLING_CUSTOMER_KEY=
BILLING_ENDPOINT_URL=https://production.billingapi.co.uk/api/customer-routes/get-quote
