# ---------------------------------------------------------------------------
# Checkout Demo — server configuration
# Copy to .env and fill in. NEVER commit the filled-in .env.
# ---------------------------------------------------------------------------

# Port the Express server listens on (hosts usually set this for you)
PORT=3001


# --- Voila (app.heyvoila.io) ------------------------------------------------
# These two headers are the ONLY authentication Voila requires.
VOILA_API_USER=
VOILA_API_TOKEN=
# Company the presets are registered against, e.g. "Moov Master"
VOILA_AUTH_COMPANY=

# --- Billing API ------------------------------------------------------------
BILLING_CLIENT_NAME=Moov Parcel
BILLING_CUSTOMER_DC_ID=Kitloop
BILLING_CUSTOMER_KEY=
BILLING_ENDPOINT_URL=https://production.billingapi.co.uk/api/customer-routes/get-quote

# --- UPS live negotiated rates (international) --------------------------------
# The Billing API returns nothing for non-GB destinations; UPS covers those.
# Everything here stays server-side and never reaches a browser.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
# test = CIE sandbox, returns SAMPLE prices. production = your real negotiated rates.
UPS_ENV=test
UPS_RATING_VERSION=v2403
# Optional: mark the negotiated cost up here so the browser never sees your buy
# price. Leave blank to pass the cost through and mark up with pricing rules.
UPS_MARKUP_PCT=
# Collection address used as Shipper and ShipFrom.
UPS_SHIPPER_NAME=MOOV Parcel
UPS_SHIPPER_ADDRESS=1 Mellor Meadows
UPS_SHIPPER_CITY=Whittington
UPS_SHIPPER_POSTCODE=SY11 4FN
UPS_SHIPPER_COUNTRY=GB
